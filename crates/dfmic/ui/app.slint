// dfmic — the microphone, at a glance.
//
// Design intent:
//   * one screen, no navigation. The answer to "is my mic filtered?" is the
//     largest thing on it;
//   * the meters are real meters: visible unfilled track, dBFS readout, red
//     reserved for clipping, and they respond independently;
//   * everything sits on one 18px inset grid, so nothing floats;
//   * expert controls are collapsed, explained, and marked with the defaults.

import { VerticalBox, HorizontalBox, Button, Slider } from "std-widgets.slint";

export global Theme {
    out property <color> bg: #101216;
    out property <color> card: #191c22;
    out property <color> card-hi: #22262f;
    out property <color> track: #0b0d10;
    out property <color> text: #eceef1;
    out property <color> text-2: #a7aeb9;
    // 5.2:1 on cards, 5.7:1 on the window: small labels stay legible (WCAG AA).
    out property <color> text-3: #868e9b;
    out property <color> accent: #5fe3a1;
    out property <color> accent-dim: #235c42;
    out property <color> warn: #f2b544;
    out property <color> danger: #f2544b;
    out property <length> radius: 16px;
    out property <length> inset: 18px;
}

/// Linear amplitude -> dBFS, clamped to the meter's floor.
component Meter inherits Rectangle {
    in property <float> level: 0.0;
    in property <string> caption: "INPUT";
    in property <bool> live: false;

    height: 88px;
    border-radius: Theme.radius;
    background: Theme.card;
    border-width: 1px;
    border-color: Theme.card-hi;

    // dBFS, floored at -60 so the scale is stable and readable.
    property <float> dbfs: level <= 0.000001 ? -60.0 : Math.max(-60.0, 20.0 * Math.log(level, 10));
    property <float> fill: (dbfs + 60.0) / 60.0;
    property <bool> hot: dbfs > -3.0;

    VerticalLayout {
        padding-left: Theme.inset;
        padding-right: Theme.inset;
        padding-top: 11px;
        padding-bottom: 12px;
        spacing: 8px;

        HorizontalLayout {
            Text {
                text: caption;
                color: Theme.text-2;
                font-size: 10px;
                font-weight: 700;
                letter-spacing: 1.5px;
                vertical-alignment: center;
            }
            Rectangle {}
            Text {
                text: root.dbfs <= -59.5 ? "—" : (Math.round(root.dbfs) + " dBFS");
                color: root.hot ? Theme.danger : Theme.text-2;
                font-size: 11px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }

        // The meter itself: dark track, filled bar, ticks at labelled dBFS values.
        Rectangle {
            height: 12px;
            border-radius: 6px;
            background: Theme.track;
            clip: true;

            Rectangle {
                x: 1px;
                y: 1px;
                height: parent.height - 2px;
                width: max(0px, (parent.width - 2px) * root.fill);
                border-radius: 5px;
                background: root.fill > 0.9
                    ? @linear-gradient(90deg, #2f8f63 0%, #5fe3a1 70%, #f2b544 88%, #f2544b 100%)
                    : @linear-gradient(90deg, #2f8f63 0%, #5fe3a1 100%);
                animate width { duration: 80ms; easing: ease-out; }
            }

            // Ticks at -40, -20 and -6 dBFS on the -60..0 scale.
            for t in [0.3333, 0.6667, 0.9] : Rectangle {
                x: parent.width * t;
                width: 1px;
                height: parent.height;
                background: #ffffff1f;
            }
        }

        // Scale legend, so the bar is a measurement and not decoration.
        HorizontalLayout {
            height: 10px;
            padding-left: 1px;
            padding-right: 1px;
            Text { text: "-60"; color: Theme.text-3; font-size: 8px; }
            Rectangle {}
            Text { text: "-40"; color: Theme.text-3; font-size: 8px; }
            Rectangle {}
            Text { text: "-20"; color: Theme.text-3; font-size: 8px; }
            Rectangle {}
            Text { text: "-6"; color: Theme.text-3; font-size: 8px; }
            Rectangle {}
            Text { text: "0"; color: Theme.text-3; font-size: 8px; }
        }
    }
}

component Chip inherits Rectangle {
    in property <string> label;
    in property <bool> ok: true;
    height: 24px;
    width: ctext.preferred-width + 20px;
    border-radius: 12px;
    background: Theme.card;
    border-width: 1px;
    border-color: Theme.card-hi;
    ctext := Text {
        x: 10px;
        vertical-alignment: center;
        text: root.label;
        color: root.ok ? Theme.text-2 : Theme.warn;
        font-size: 11px;
        font-weight: 600;
    }
}

component Segment inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    callback picked();
    border-radius: 9px;
    background: selected ? Theme.accent-dim : transparent;
    Text {
        text: root.label;
        color: root.selected ? Theme.accent : Theme.text-3;
        horizontal-alignment: center;
        vertical-alignment: center;
        font-size: 12px;
        font-weight: 700;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
}

component Disclosure inherits Rectangle {
    in property <string> label;
    in property <bool> open: false;
    callback toggled();
    height: 26px;
    width: dleft.preferred-width + dtext.preferred-width + 10px;
    background: transparent;
    dleft := Text {
        text: root.open ? "▾" : "▸";
        color: Theme.text-2;
        font-size: 11px;
        vertical-alignment: center;
    }
    dtext := Text {
        x: dleft.preferred-width + 8px;
        text: root.label;
        color: Theme.text-2;
        font-size: 12px;
        vertical-alignment: center;
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(); }
    }
}

export component AppWindow inherits Window {
    title: "DeepFilter Mic";
    width: 400px;
    height: 544px;
    background: Theme.bg;
    default-font-size: 13px;
    // Content is fixed-layout; keep the window at its natural size.
    preferred-width: 400px;
    preferred-height: 544px;

    in-out property <bool> enabled: true;
    in-out property <bool> connected: false;
    in-out property <bool> listening: false;   // a consumer is attached
    in-out property <float> input-level: 0.0;
    in-out property <float> output-level: 0.0;
    in-out property <string> device: "NPU";
    in-out property <string> source: "";
    // Derived from the PipeWire node name by the GUI: "Mic1" out of
    // "alsa_input.pci-0000_00_1f.3-...HiFi__Mic1__source".
    in-out property <string> friendly-source: "Microphone";
    in-out property <string> bus-name: "internal";
    in-out property <float> latency-ms: 10.0;
    in-out property <int> inferences: 0;
    in-out property <int> dropped: 0;
    in-out property <string> error: "";
    in-out property <bool> show-expert: false;
    in-out property <float> atten-lim: 100;
    in-out property <float> post-filter: 0.0;

    callback toggle();
    callback set-atten(float);
    callback set-post-filter(float);
    callback quit();

    VerticalLayout {
        padding: Theme.inset;
        spacing: 12px;

        // ---------------------------------------------------------- header
        HorizontalLayout {
            height: 22px;
            Text {
                text: "DeepFilter Mic";
                color: Theme.text;
                font-size: 16px;
                font-weight: 700;
                vertical-alignment: center;
            }
            Rectangle {}
            HorizontalLayout {
                alignment: center;
                spacing: 6px;
                Rectangle {
                    width: 6px; height: 6px; border-radius: 3px;
                    background: root.connected ? Theme.accent : Theme.danger;
                }
                Text {
                    text: root.connected ? (root.listening ? "in use" : "ready") : "no daemon";
                    color: Theme.text-3;
                    font-size: 11px;
                    vertical-alignment: center;
                }
            }
        }

        // ------------------------------------------------- status + toggle
        Rectangle {
            height: 78px;
            border-radius: Theme.radius;
            background: Theme.card;
            border-width: 1px;
            border-color: root.enabled ? Theme.accent-dim : Theme.card-hi;

            HorizontalLayout {
                padding-left: Theme.inset;
                padding-right: 12px;
                spacing: 14px;
                VerticalLayout {
                    alignment: center;
                    spacing: 3px;
                    Text {
                        text: root.enabled ? "Filtering" : "Off";
                        color: root.enabled ? Theme.accent : Theme.text-3;
                        font-size: 20px;
                        font-weight: 700;
                    }
                    Text {
                        text: root.enabled
                            ? "Noise suppressed · DeepFilterNet3"
                            : "Raw microphone pass-through";
                        color: Theme.text-3;
                        font-size: 10px;
                        wrap: no-wrap;
                        overflow: elide;
                    }
                }
                Rectangle {
                    width: 92px;
                    height: 32px;
                    border-radius: 10px;
                    background: Theme.track;
                    HorizontalLayout {
                        padding: 3px;
                        spacing: 0px;
                        Segment { label: "Off"; selected: !root.enabled; picked => { root.toggle(); } }
                        Segment { label: "On"; selected: root.enabled; picked => { root.toggle(); } }
                    }
                }
            }
        }

        // ---------------------------------------------------------- meters
        Meter { caption: "MICROPHONE"; level: root.input-level; live: root.listening; }
        Meter { caption: "TO APPS"; level: root.output-level; live: root.listening; }

        // ----------------------------------------------------------- chips
        HorizontalLayout {
            height: 24px;
            spacing: 7px;
            Chip { label: root.device; }
            Chip { label: root.latency-ms + " ms"; }
            Chip { label: root.dropped > 0 ? (root.dropped + " drops") : "no drops"; ok: root.dropped == 0; }
            Rectangle {}
        }

        // ------------------------------------------------------ input device
        Rectangle {
            height: 1px;
            background: Theme.card-hi;
        }
        VerticalLayout {
            spacing: 3px;
            height: 40px;
            Text {
                text: "INPUT DEVICE";
                color: Theme.text-3;
                font-size: 9px;
                font-weight: 700;
                letter-spacing: 1.5px;
            }
            HorizontalLayout {
                spacing: 6px;
                Text {
                    text: root.source == "" ? "—" : root.friendly-source;
                    color: Theme.text;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                }
                Text {
                    text: root.source == "" ? "" : "· " + root.bus-name;
                    color: Theme.text-3;
                    font-size: 10px;
                    vertical-alignment: center;
                }
                Rectangle {}
            }
        }

        // --------------------------------------------------------- advanced
        Rectangle {
            height: 26px;
            background: transparent;
            Text {
                text: "Advanced";
                color: Theme.text-2;
                font-size: 12px;
                font-weight: 600;
                vertical-alignment: center;
            }
            adv := Text {
                x: parent.width - self.width;
                text: root.show-expert ? "Hide ▴" : "Show ▾";
                color: Theme.text-2;
                font-size: 10px;
                vertical-alignment: center;
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.show-expert = !root.show-expert; }
            }
        }

        if root.show-expert: VerticalLayout {
            spacing: 12px;
            Text {
                text: "The defaults are what DeepFilterNet recommends. Lower attenuation keeps more of the room around your voice; raising the post filter can sound hollow.";
                color: Theme.text-3;
                font-size: 10px;
                wrap: word-wrap;
            }

            VerticalLayout {
                spacing: 3px;
                HorizontalLayout {
                    Text { text: "Attenuation limit"; color: Theme.text-2; font-size: 11px; vertical-alignment: center; }
                    Rectangle {}
                    Text {
                        text: root.atten-lim >= 100 ? "100 dB · full" : (Math.round(root.atten-lim) + " dB");
                        color: Theme.text-3; font-size: 10px; vertical-alignment: center;
                    }
                }
                Slider {
                    minimum: 6; maximum: 100; value: root.atten-lim;
                    changed(v) => { root.set-atten(v); }
                }
            }
            VerticalLayout {
                spacing: 3px;
                HorizontalLayout {
                    Text { text: "Post filter"; color: Theme.text-2; font-size: 11px; vertical-alignment: center; }
                    Rectangle {}
                    Text {
                        text: root.post-filter <= 0.0 ? "β 0 · off" : ("β " + Math.round(root.post-filter * 1000.0) / 1000.0);
                        color: Theme.text-3; font-size: 10px; vertical-alignment: center;
                    }
                }
                Slider {
                    minimum: 0; maximum: 0.05; value: root.post-filter;
                    changed(v) => { root.set-post-filter(v); }
                }
            }
        }

        if root.error != "": Rectangle {
            height: 46px;
            border-radius: 10px;
            background: #2a1517;
            border-width: 1px;
            border-color: Theme.danger;
            Text {
                x: 12px; y: 8px;
                text: root.error;
                color: #ff8a84;
                font-size: 10px;
                wrap: word-wrap;
                width: parent.width - 24px;
            }
        }

        // ----------------------------------------------------------- footer
        HorizontalLayout {
            height: 30px;
            Text {
                text: root.inferences > 0
                    ? ("DeepFilterNet3_ll · " + root.inferences + " inferences")
                    : "DeepFilterNet3_ll · idle";
                color: Theme.text-2;
                font-size: 10px;
                vertical-alignment: center;
                overflow: elide;
            }
            Rectangle {}
            Button {
                text: "Quit";
                clicked => { root.quit(); }
            }
        }
    }
}
