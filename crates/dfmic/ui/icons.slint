// A small authored icon set: 24-unit grid, round caps, one stroke weight.

import { Theme } from "theme.slint";

export enum IconKind {
    waveform, power, mic, headset, bluetooth, usb, laptop, webcam, virtual,
    check, warning, cross, plug, chevron, chevron-up, copy, reset, speaker, headphones,
    info, ear, undo, clock, auto, record, play, download,
}

export component Icon inherits Path {
    in property <IconKind> kind;
    in property <color> color: Theme.text;
    in property <length> size: 18px;
    width: size;
    height: size;
    viewbox-x: 0;
    viewbox-y: 0;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: transparent;
    stroke: color;
    stroke-width: size <= 16px ? 2px : 1.8px;
    stroke-line-cap: round;
    accessible-role: none;
    commands: kind == IconKind.waveform ? "M3 12h1.5 M7 8.5v7 M11 4.5v15 M15 8v8 M19 10.5v3 M21.5 12h-.5"
        : kind == IconKind.power ? "M12 3.5v8 M7.4 6.6a7.2 7.2 0 1 0 9.2 0"
        : kind == IconKind.mic ? "M9 6a3 3 0 0 1 6 0v5.5a3 3 0 0 1-6 0z M5.5 11a6.5 6.5 0 0 0 13 0 M12 17.5v3.5 M9 21h6"
        : kind == IconKind.headset ? "M4.5 14v-2a7.5 7.5 0 0 1 15 0v2 M4.5 14h2.5v5h-1.5a1 1 0 0 1-1-1z M19.5 14h-2.5v5h1.5a1 1 0 0 0 1-1z M17 19c0 1.5-2 2.5-4.5 2.5"
        : kind == IconKind.bluetooth ? "M7 7.5l10 9-5 4.5v-18l5 4.5-10 9"
        : kind == IconKind.usb ? "M12 3v14 M10 6l2-3 2 3 M12 14.5l-4.5-3v-3 M12 12.5l4.5-3v-2 M15.5 5.5h2v2h-2z M10 19.5a2 2 0 1 0 4 0a2 2 0 1 0-4 0 M7.5 7.5a1 1 0 1 0 0 1"
        : kind == IconKind.laptop ? "M5 6.5a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v9H5z M2.5 18.5h19"
        : kind == IconKind.webcam ? "M5 10a7 7 0 1 0 14 0a7 7 0 1 0-14 0 M10 10a2 2 0 1 0 4 0a2 2 0 1 0-4 0 M8 21h8 M12 17v4"
        : kind == IconKind.virtual ? "M3 12h3l2.5-6 4 12 3-9 2 3H21"
        : kind == IconKind.clock ? "M4.5 12a7.5 7.5 0 1 0 15 0a7.5 7.5 0 1 0-15 0 M12 7.5V12l3 1.8"
        // A circular arrow: "handled automatically".
        : kind == IconKind.auto ? "M12 5a7 7 0 0 1 6.2 3.7 M18.2 8.7V5.4 M18.2 8.7h-3.2 M12 19a7 7 0 0 1-6.2-3.7 M5.8 15.3v3.3 M5.8 15.3h3.2"
        // A filled dot: record.
        : kind == IconKind.record ? "M12 8.5a3.5 3.5 0 1 0 0 7a3.5 3.5 0 1 0 0-7"
        // An arrow into a tray: download.
        : kind == IconKind.download ? "M12 4v10 M7.5 10l4.5 4.5 4.5-4.5 M4.5 18.5h15"
        // A play triangle.
        : kind == IconKind.play ? "M9 6.5l8 5.5l-8 5.5z"
        : kind == IconKind.check ? "M5 12.5l4.5 4.5L19 7"
        : kind == IconKind.warning ? "M12 3.5l9.5 16.5h-19z M12 10v4.5 M12 17.3v.2"
        : kind == IconKind.cross ? "M6.5 6.5l11 11 M17.5 6.5l-11 11"
        : kind == IconKind.plug ? "M9 3v5 M15 3v5 M6.5 8h11v3.5a5.5 5.5 0 0 1-11 0z M12 17v4"
        : kind == IconKind.chevron ? "M6.5 9.5l5.5 5.5 5.5-5.5"
        // The same chevron, flipped. A separate path rather than a rotation
        // because Slint's software renderer cannot transform items, and the
        // window runs on that renderer by default.
        : kind == IconKind.chevron-up ? "M6.5 14.5l5.5-5.5 5.5 5.5"
        : kind == IconKind.copy ? "M9 9h10.5v10.5H9z M15 9V4.5H4.5V15H9"
        : kind == IconKind.reset ? "M4.5 4.5v5h5 M5.2 9.5A7.5 7.5 0 1 1 4.5 12"
        : kind == IconKind.speaker ? "M4 9.5h3.5l5-4v13l-5-4H4z M16 9.5a3.5 3.5 0 0 1 0 5 M18.5 7a7 7 0 0 1 0 10"
        : kind == IconKind.headphones ? "M4.5 17v-5a7.5 7.5 0 0 1 15 0v5 M4.5 14.5h3v6h-2a1 1 0 0 1-1-1z M19.5 14.5h-3v6h2a1 1 0 0 0 1-1z"
        : kind == IconKind.info ? "M3 12a9 9 0 1 0 18 0a9 9 0 1 0-18 0 M12 11v5.5 M12 7.7v.2"
        : kind == IconKind.ear ? "M7 9a5 5 0 0 1 10 0c0 3-3 4-3 7a3 3 0 0 1-5.5 1.5 M10 9.5a2 2 0 0 1 4 0c0 1.2-1.2 1.6-1.6 2.4"
        : "M9 14L4 9l5-5 M4 9h10.5a5.5 5.5 0 0 1 0 11H11";
}
